---
import type { EnrichedRepo } from "../lib/types";

interface Props {
  repo: EnrichedRepo;
  rank: number;
}

const { repo, rank } = Astro.props;
---

<article
  class="group rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 transition hover:border-zinc-400 dark:hover:border-zinc-600 hover:shadow-sm"
>
  <header class="flex items-start justify-between gap-4 mb-3">
    <div class="flex items-baseline gap-2">
      <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500 tabular-nums">
        #{String(rank).padStart(2, "0")}
      </span>
      <a
        href={repo.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 hover:underline underline-offset-4"
      >
        {repo.fullName}
      </a>
    </div>
    <div class="flex items-center gap-3 text-xs text-zinc-500 dark:text-zinc-400 tabular-nums whitespace-nowrap">
      <span title="Total stars">★ {repo.stars.toLocaleString()}</span>
      {repo.starsToday > 0 && (
        <span class="text-emerald-600 dark:text-emerald-400" title="Added in period">
          +{repo.starsToday.toLocaleString()}
        </span>
      )}
    </div>
  </header>

  {repo.description && (
    <p class="text-sm text-zinc-700 dark:text-zinc-300 mb-4 leading-relaxed">
      {repo.description}
    </p>
  )}

  {repo.ai && (
    <div class="space-y-3 border-t border-zinc-100 dark:border-zinc-800 pt-3 mt-2">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded-full bg-zinc-100 dark:bg-zinc-800 px-2.5 py-0.5 text-xs font-medium text-zinc-700 dark:text-zinc-300">
          {repo.ai.category}
        </span>
        {repo.language && (
          <span class="inline-flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400">
            <span
              class="w-2.5 h-2.5 rounded-full border border-zinc-300 dark:border-zinc-700"
              style={`background-color: ${repo.languageColor ?? "transparent"}`}
            ></span>
            {repo.language}
          </span>
        )}
      </div>
      <p class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
        {repo.ai.shortSummary}
      </p>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 italic leading-relaxed">
        なぜ trending: {repo.ai.whyTrending}
      </p>
    </div>
  )}

  {!repo.ai && repo.language && (
    <div class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400 mt-2">
      <span
        class="w-2.5 h-2.5 rounded-full border border-zinc-300 dark:border-zinc-700"
        style={`background-color: ${repo.languageColor ?? "transparent"}`}
      ></span>
      {repo.language}
    </div>
  )}
</article>
